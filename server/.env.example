# ==============================================
# MinjaPhotobooth Backend — Environment Variables
# ==============================================
# Salin file ini ke .env dan isi semua nilainya.
# File .env TIDAK BOLEH di-commit ke Git.
# ==============================================

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/minjaphotobooth

# --- JWT ---
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# --- Booth API Key ---
BOOTH_API_KEY=ganti-dengan-string-unik-per-mesin

# --- Midtrans ---
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# --- WhatsApp Cloud API ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# --- Object Storage (S3-compatible) ---
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=minjaphotobooth
S3_REGION=auto

# --- App ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
